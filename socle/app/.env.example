# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# --- Identité de l'application -----------------------------------------------------------------
APP_NAME=Application de démonstration
APP_SHORT_NAME=Démo
APP_DESCRIPTION=Application de gestion
APP_THEME_COLOR=#1f3a5f
# « demo » : badge Démo et effacement complet autorisé ; vide : version finale.
APP_EDITION=demo
# Nom du cookie de session, propre à l'application : minuscules, chiffres, soulignés.
SESSION_COOKIE_NAME=app_session
# Durée d'une session sans activité, en jours.
SESSION_TTL_DAYS=30

# --- Base PostgreSQL ---------------------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/app
# Base d'administration du serveur de test : chaque lancement de `pnpm test:db` y crée sa propre
# base test_…, puis la supprime.
DATABASE_URL_TEST=postgres://app:app@localhost:5432/postgres

# Mot de passe des comptes de démonstration admin, gestion et terrain : 10 caractères minimum.
DEMO_PASSWORD=change-me-please

# --- Fichiers : photos, PDF, mails, sauvegardes ------------------------------------------------
# local : dossier sur le disque, pour le développement et les tests.
# s3 : tout stockage compatible S3, bucket privé, de préférence dans la même région que la base.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- PDF : Chromium sans interface, via playwright-core ----------------------------------------
# En local, le navigateur des tests Playwright suffit. Dans l'image Docker, il est installé.
# PLAYWRIGHT_BROWSERS_PATH=
# PDF_CHROMIUM_PATH=

# --- Sauvegardes -------------------------------------------------------------------------------
# Nombre de jours de sauvegardes conservées dans le stockage, préfixe backups/.
BACKUP_RETENTION_DAYS=30
# Chemin de pg_dump et pg_restore s'ils ne sont pas dans le PATH.
# PG_BIN_DIR=/usr/lib/postgresql/16/bin
