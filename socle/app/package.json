    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:wake": "tsx scripts/demo-wake.ts",
    "data:import": "tsx scripts/import-data.ts",
    "data:purge": "tsx scripts/purge-data.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "local:setup": "bash scripts/local-setup.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@kenjiuno/msgreader": "1.28.0",
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-popover": "1.3.1",
    "@tanstack/react-virtual": "3.14.19",
    "clsx": "2.1.1",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "lucide-react": "1.56.0",
